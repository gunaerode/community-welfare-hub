# Copy to server/.env for local development. On a host (Render, Railway, VPS…)
# set these as environment variables instead.

# Port the API listens on (hosts usually set this for you)
PORT=8787

# Password for the website's Admin page (#/admin). Use 12+ random characters.
ADMIN_TOKEN=change-me-to-a-long-random-password

# Which websites may call this API (comma-separated, no trailing slash).
# Use "*" to allow any site.
ALLOWED_ORIGINS=https://gunaerode.github.io,http://localhost:5173

# Folder where db.json is stored. Point it at a persistent disk/volume in production.
DATA_DIR=./data
